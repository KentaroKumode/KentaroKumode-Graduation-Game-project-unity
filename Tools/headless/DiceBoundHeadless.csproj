<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity を使わずにゲームの計算部分と BOT を回す並列ワーカー。 .cs は Assets/Scripts をリンクするだけ (複製しない)。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DiceBoundHeadless</AssemblyName>
    <RootNamespace>DiceBoundHeadless</RootNamespace>
    <!-- ゲームの .cs とデータの根 (既定 = このリポジトリ)。 照合で別の作業ツリーの版を作る時だけ -p:GameRoot=... で差し替える -->
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\..\</GameRoot>
    <DefineConstants>$(DefineConstants);HEADLESS</DefineConstants>
    <NoWarn>$(NoWarn);0169;0649;0414;0067;0162;0219;0108;0114;0618;0672;CS8632;CS1998;CS0436</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 段階 JIT は入れたまま (動的 PGO が効く)、 呼び出しの数え始めの遅延 (既定 100 ms・起動の間ずっと延び続ける) を 0 にする。
         2026-11-22 の実測 (22 並列・同じシードの対で同時に回した比・段階 JIT を切った版を 1): 1 プロセス 15 ラン 0.86 / 300 ラン 0.86
         (既定の段階 JIT は 1.44 / 0.91・ReadyToRun は 0.85 / 0.90 で長い仕事で負ける)。 結果は全チャンクで一致 -->
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Shim\**\*.cs;Program.cs;SelfTest.cs" />
    <Compile Include="$(GameRoot)Assets\Scripts\**\*.cs"
             Exclude="$(GameRoot)Assets\Scripts\UI\**;$(GameRoot)Assets\Scripts\**\Editor\**;$(GameRoot)Assets\Scripts\**\Tests\**;$(GameRoot)Assets\Scripts\CameraMouseFollow.cs"
             Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- 画面だけの部品 (どこからも参照されない・IMGUI / カメラ) -->
    <Compile Remove="$(GameRoot)Assets\Scripts\GameLoop\GameDebugHUD.cs;$(GameRoot)Assets\Scripts\GameLoop\PhaseDirector.cs;$(GameRoot)Assets\Scripts\GameLoop\PhaseSceneRouter.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Player がビルド時に焼き込むデータと同じものを exe の隣へ写す (Resources/ と ItemDatabase の items.json) -->
    <None Include="$(GameRoot)Assets\Resources\enemies.json" Link="Resources\enemies.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameRoot)Assets\Resources\meta_board_panels.json" Link="Resources\meta_board_panels.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameRoot)Assets\Resources\Events\*.txt" Link="Resources\Events\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameRoot)Assets\Data\InventorySystem\items.json" Link="Data\items.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
