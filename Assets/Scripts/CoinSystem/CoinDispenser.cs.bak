using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using System;

namespace CoinSystem
{
    public class CoinDispenser : MonoBehaviour
    {
        [Header("蜿ら・繧ｳ繝ｳ繝昴・繝阪Φ繝・)]
        private CoinPoolManager poolManager;
        private CoinAudioManager audioManager;
        private CoinStackManager stackManager;
        private TicketSystemManager ticketManager;
        private PaymentManager paymentManager;
        private CoinTicketConversionManager conversionManager;
        
        [Header("謗貞・險ｭ螳・)]
        [SerializeField] private Transform dispenserPoint; // 謾ｯ謇輔＞蜿｣
        [SerializeField] private Transform potTarget; // 繝昴ャ繝茨ｼ亥女縺醍堊・・
        [SerializeField] private float dispenseForce = 5f; // 謗貞・蜉・
        [SerializeField] private Vector3 forceDirection = Vector3.right; // 謗貞・譁ｹ蜷・
        [SerializeField] private float randomForceRange = 1f; // 繝ｩ繝ｳ繝繝隕∫ｴ
        
        [Header("蜿ｯ螟蛾溷ｺｦ險ｭ螳・)]
        [SerializeField] private bool enableVariableSpeed = false; // 蜿ｯ螟蛾溷ｺｦ繝｢繝ｼ繝峨・譛牙柑/辟｡蜉ｹ
        [SerializeField] private int speedScaleThreshold = 100; // 縺薙・譫壽焚縺ｧ譛螟ｧ騾溷ｺｦ縺ｫ縺ｪ繧・
        [SerializeField] [Range(0.01f, 1.0f)] private float minDispenseInterval = 0.02f; // 譛鬮倬溷ｺｦ譎ゅ・謗貞・髢馴囈
        [SerializeField] [Range(0.01f, 1.0f)] private float maxDispenseInterval = 0.2f; // 譛菴朱溷ｺｦ譎ゅ・謗貞・髢馴囈
        
        [Header("謨ｴ蛻怜盾辣ｧ")]
        [SerializeField] private Transform stackStartPoint; // 謨ｴ蛻鈴幕蟋倶ｽ咲ｽｮ
        
        [Header("繝√こ繝・ヨ蜿ら・")]
        [SerializeField] private Transform ticketMachinePoint;
        [SerializeField] private Vector3 ticketDirection = Vector3.down;
        
        // 蜀・Κ螟画焚
        private bool isDispensing = false;
        private bool isSorting = false;
        private bool isConsuming = false;
        
        // 繝｡繝｢繝ｪ蜉ｹ邇・喧逕ｨ縺ｮ蜀榊茜逕ｨ蜿ｯ閭ｽ螟画焚
        private Vector3 randomOffset = Vector3.zero;
        private Vector3 tempTorque = Vector3.zero;
        
        // WaitForSeconds縺ｮ繧ｭ繝｣繝・す繝･・医Γ繝｢繝ｪ繝ｪ繝ｼ繧ｯ蟇ｾ遲厄ｼ・
        private WaitForSeconds[] cachedWaits;
        private const int maxCachedWaits = 20;
        
        // 繧､繝吶Φ繝・
        public event Action<int> OnDispenseComplete;
        public event Action<int> OnSortComplete;
        
        // 繝励Ο繝代ユ繧｣
        public bool IsDispensing => isDispensing;
        public bool IsSorting => isSorting;
        public GameObject CoinPrefab => poolManager?.CoinPrefab;
        public int ActiveCoinCount => poolManager?.ActiveCoinCount ?? 0;
        public int StackCount => stackManager?.StackCount ?? 0;
        public int CurrentStackCoinCount => stackManager?.CurrentStackCoinCount ?? 0;
        public int TotalStackedCoins => stackManager?.TotalStackedCoins ?? 0;
        public int ActiveTicketCount => ticketManager?.ActiveTicketCount ?? 0;
        
        private void Awake()
        {
            Debug.Log("[CoinDispenser] Initializing...");
            
            // 繧ｳ繝ｳ繝昴・繝阪Φ繝亥盾辣ｧ繧貞叙蠕・
            poolManager = GetComponent<CoinPoolManager>();
            audioManager = GetComponent<CoinAudioManager>();
            stackManager = GetComponent<CoinStackManager>();
            ticketManager = GetComponent<TicketSystemManager>();
            paymentManager = GetComponent<PaymentManager>();
            conversionManager = GetComponent<CoinTicketConversionManager>();
            
            if (poolManager == null)
                Debug.LogError("CoinPoolManager not found! Make sure it's attached to the same GameObject.");
            if (audioManager == null)
                Debug.LogError("CoinAudioManager not found! Make sure it's attached to the same GameObject.");
            if (stackManager == null)
                Debug.LogError("CoinStackManager not found! Make sure it's attached to the same GameObject.");
            if (ticketManager == null)
                Debug.LogError("TicketSystemManager not found! Make sure it's attached to the same GameObject.");
            if (paymentManager == null)
                Debug.LogError("PaymentManager not found! Make sure it's attached to the same GameObject.");
            if (conversionManager == null)
                Debug.LogError("CoinTicketConversionManager not found! Make sure it's attached to the same GameObject.");
            
            // 蠢・医・蛻晄悄蛹・
            InitializeCachedWaits();
            
            // StackManager縺ｮ蛻晄悄蛹・
            if (stackManager != null && stackStartPoint != null)
            {
                // stackStartPoint繧担tackManager縺ｫ險ｭ螳・
                var field = typeof(CoinStackManager).GetField("stackStartPoint", 
                    System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
                if (field != null)
                    field.SetValue(stackManager, stackStartPoint);
                    
                stackManager.InitializeStack();
            }
            
            // coinPrefab遒ｺ隱・
            if (poolManager != null && poolManager.CoinPrefab == null)
            {
                Debug.Log("[CoinDispenser] coinPrefab not yet assigned. Waiting for CoinSystemManager or manual assignment.");
            }
            else if (poolManager != null)
            {
                Debug.Log($"[CoinDispenser] coinPrefab assigned: {poolManager.CoinPrefab.name}");
            }
            
            Debug.Log("[CoinDispenser] Initialization complete");
        }
        
        void Update()
        {
            // 讖溯・縺ｪ縺暦ｼ医け繝ｪ繝ｼ繝ｳ繧｢繝・・縺ｯ蜷・さ繝ｳ繝昴・繝阪Φ繝医〒邂｡逅・ｼ・
        }
        
        /// <summary>
        /// 邱頑･蟇ｾ遲厄ｼ哂udioListener驥崎､・ｒ蠑ｷ蛻ｶ菫ｮ豁｣
        /// </summary>
        private void EmergencyAudioListenerFix()
        {
            AudioListener[] listeners = FindObjectsOfType<AudioListener>();
            if (listeners.Length > 1)
            {
                emergencyFixCount++;
                
                // 繝｡繧､繝ｳ繧ｫ繝｡繝ｩ莉･螟悶・AudioListener繧貞炎髯､
                Camera mainCamera = Camera.main;
                AudioListener mainListener = mainCamera?.GetComponent<AudioListener>();
                
                int removedCount = 0;
                foreach (var listener in listeners)
                {
                    if (listener != mainListener && listener != null)
                    {
                        // 縺ｩ縺ｮ繧ｪ繝悶ず繧ｧ繧ｯ繝医↓莉倥＞縺ｦ縺・ｋ縺九ｒ隧ｳ邏ｰ繝ｭ繧ｰ
                        GameObject parent = listener.transform.parent?.gameObject;
                        string parentName = parent != null ? parent.name : "None";
                        Debug.LogError($"Removing AudioListener from: {listener.gameObject.name} (Parent: {parentName})");
                        Destroy(listener);
                        removedCount++;
                    }
                }
                
                // 驥崎ｦ√↑菫ｮ豁｣縺ｮ縺ｿ繝ｭ繧ｰ蜃ｺ蜉・
                if (removedCount > 0)
                {
                    Debug.LogWarning($"[AudioListener Fix #{emergencyFixCount}] Removed {removedCount} duplicates");
                }
            }
        }
        
        private void InitializeCachedWaits()
        {
            cachedWaits = new WaitForSeconds[maxCachedWaits];
            for (int i = 0; i < maxCachedWaits; i++)
            {
                float waitTime = 0.01f + (i * 0.05f); // 0.01縺九ｉ0.96遘偵∪縺ｧ
                cachedWaits[i] = new WaitForSeconds(waitTime);
            }
        }
        
        private WaitForSeconds GetCachedWaitForSeconds(float seconds)
        {
            // 蛻晄悄蛹悶メ繧ｧ繝・け
            if (cachedWaits == null || cachedWaits.Length == 0)
            {
                Debug.LogWarning("[CoinDispenser] WaitForSeconds cache not initialized! Initializing now...");
                InitializeCachedWaits();
            }
            
            // 0.01-0.96遘偵・遽・峇縺ｧ繧ｭ繝｣繝・す繝･縺輔ｌ縺溷､繧剃ｽｿ逕ｨ
            int index = Mathf.Clamp(Mathf.RoundToInt((seconds - 0.01f) / 0.05f), 0, maxCachedWaits - 1);
            return cachedWaits[index];
        }

        /// <summary>
        /// 繧ｳ繧､繝ｳ髻ｳ逕ｨ縺ｮ隍・焚AudioSource繧貞・譛溷喧
        /// </summary>
        
        private void ValidateComponents()
        {
            if (dispenserPoint == null)
            {
                Debug.LogWarning("Dispenser Point is not assigned. Using this transform as dispenser point.");
                dispenserPoint = transform;
            }
            
            if (potTarget == null)
            {
                Debug.LogWarning("Pot Target is not assigned. Creating default target.");
                GameObject defaultTarget = new GameObject("DefaultPotTarget");
                defaultTarget.transform.SetParent(transform);
                defaultTarget.transform.localPosition = Vector3.forward * 2f;
                potTarget = defaultTarget.transform;
            }
            
            if (stackStartPoint == null)
            {
                Debug.LogWarning("Stack Start Point is not assigned. Using pot target as stack start point.");
                stackStartPoint = potTarget;
            }
        }
        
        /// <summary>
        /// 繧ｳ繧､繝ｳ繧呈欠螳壽椢謨ｰ謗貞・縺吶ｋ
        /// </summary>
        /// <param name="amount">謗貞・縺吶ｋ繧ｳ繧､繝ｳ譫壽焚</param>
        public void DispenseCoins(int amount)
        {
            if (poolManager == null || poolManager.CoinPrefab == null)
            {
                Debug.LogError("[CoinDispenser] Cannot dispense: coinPrefab is not assigned!");
                return;
            }
            
            if (isDispensing)
            {
                Debug.LogWarning("Already dispensing coins. Wait for completion.");
                return;
            }
            
            if (amount <= 0)
            {
                Debug.LogWarning("Amount must be greater than 0.");
                return;
            }
            
            StartCoroutine(DispenseCoinsCoroutine(amount));
        }
        
        private IEnumerator DispenseCoinsCoroutine(int amount)
        {
            isDispensing = true;
            
            // 謇輔＞蜃ｺ縺鈴幕蟋矩浹繧貞・逕・
            audioManager?.PlayDispensingSound();
            
            // 譫壽焚縺ｫ蠢懊§縺滓賜蜃ｺ髢馴囈繧定ｨ育ｮ・
            float currentDispenseInterval = GetScaledSpeed(amount, minDispenseInterval, maxDispenseInterval);
            
            // 繝√こ繝・ヨ繧ｷ繧ｹ繝・Β譛牙柑譎ゑｼ壽賜蜃ｺ蜑阪↓險育ｮ励＠縺ｦ縲・0譫壹ｒ雜・∴繧句・縺ｯ繝√こ繝・ヨ縺ｧ謗貞・
            int coinsToDispense = amount;
            int ticketsToDispense = 0;
            
            if (enableTicketSystem)
            {
                int currentStackedCoins = GetTotalCoinCount();
                int totalAfterDispense = currentStackedCoins + amount;
                
                if (totalAfterDispense > coinThresholdHigh)
                {
                    // 60譫壹ｒ雜・∴繧句・繧定ｨ育ｮ・
                    int excessCoins = totalAfterDispense - coinThresholdHigh;
                    // 10譫壼腰菴阪〒繝√こ繝・ヨ蛹厄ｼ亥・繧贋ｸ翫￡・・
                    ticketsToDispense = (excessCoins + coinsPerTicket - 1) / coinsPerTicket;
                    int coinsInTickets = ticketsToDispense * coinsPerTicket;
                    
                    // 繝√こ繝・ヨ縺ｧ謗貞・縺吶ｋ蛻・ｒ蟾ｮ縺怜ｼ輔￥
                    coinsToDispense = amount - coinsInTickets;
                    
                    Debug.Log($"謗貞・險育判: 迴ｾ蝨ｨ{currentStackedCoins}譫・+ 謗貞・莠亥ｮ嘴amount}譫・= {totalAfterDispense}譫・);
                    Debug.Log($"竊・繝√こ繝・ヨ{ticketsToDispense}譫・{coinsInTickets}繧ｳ繧､繝ｳ蛻・ + 繧ｳ繧､繝ｳ{coinsToDispense}譫壹ｒ謗貞・");
                }
            }
            
            try
            {
                // poolManager.ActiveCoins繧偵け繝ｪ繧｢貂医∩
                
                // 蜈医↓繝√こ繝・ヨ繧呈賜蜃ｺ
                if (ticketsToDispense > 0)
                {
                    Debug.Log($"繝√こ繝・ヨ{ticketsToDispense}譫壹ｒ蜈医↓謗貞・");
                    for (int i = 0; i < ticketsToDispense; i++)
                    {
                        yield return StartCoroutine(PrintSingleTicketProcess(i));
                        yield return GetCachedWaitForSeconds(currentDispenseInterval);
                    }
                }
                
                // 谺｡縺ｫ繧ｳ繧､繝ｳ繧呈賜蜃ｺ
                for (int i = 0; i < coinsToDispense; i++)
                {
                    GameObject coin = poolManager?.GetCoinFromPool();
                    if (coin == null) break;
                    poolManager.ActiveCoins.Add(coin);
                    
                    // 謗貞・菴咲ｽｮ縺ｨ蝗櫁ｻ｢縺ｮ險ｭ螳・
                    coin.transform.position = dispenserPoint.position;
                    coin.transform.rotation = dispenserPoint.rotation;
                    coin.SetActive(true);
                    
                    // 迚ｩ逅・噪縺ｪ謗貞・
                    Rigidbody rb = coin.GetComponent<Rigidbody>();
                    rb.velocity = Vector3.zero;
                    rb.angularVelocity = Vector3.zero;
                    
                    // 繝昴ャ繝域婿蜷代∈縺ｮ蜉帙→繝ｩ繝ｳ繝繝隕∫ｴ繧貞刈縺医ｋ
                    Vector3 directionToPot = (potTarget.position - dispenserPoint.position).normalized;
                    
                    // 繝｡繝｢繝ｪ蜉ｹ邇・喧: 繝ｩ繝ｳ繝繝繧ｪ繝輔そ繝・ヨ縺ｮ蜀榊茜逕ｨ
                    randomOffset.x = UnityEngine.Random.Range(-randomForceRange, randomForceRange);
                    randomOffset.y = UnityEngine.Random.Range(0, randomForceRange * 0.5f);
                    randomOffset.z = UnityEngine.Random.Range(-randomForceRange, randomForceRange);
                    
                    Vector3 finalDirection = (directionToPot + randomOffset).normalized;
                    rb.AddForce(finalDirection * dispenseForce, ForceMode.Impulse);
                    
                    // 蝗櫁ｻ｢繧ょｰ代＠蜉縺医ｋ・医Γ繝｢繝ｪ蜉ｹ邇・喧・・
                    tempTorque.x = UnityEngine.Random.Range(-1f, 1f);
                    tempTorque.y = UnityEngine.Random.Range(-1f, 1f);
                    tempTorque.z = UnityEngine.Random.Range(-1f, 1f);
                    tempTorque = tempTorque.normalized * dispenseForce * 0.5f;
                    rb.AddTorque(tempTorque, ForceMode.Impulse);
                    
                    poolManager.ActiveCoins.Add(coin);
                    
                    // 繧ｳ繧､繝ｳ謗貞・髻ｳ・亥崋螳夐浹・峨→繝ｩ繝ｳ繝繝髻ｳ繧貞酔譎ょ・逕・
                    audioManager?.PlayDispensingSound();
                    audioManager?.PlayRandomCoinSound();
                    
                    // 繝｡繝｢繝ｪ邂｡逅・ 20譫壹＃縺ｨ縺ｫ繝輔Ξ繝ｼ繝繧定ｭｲ繧翫；C繧剃ｿ・ｲ
                    if (i > 0 && i % 20 == 0)
                    {
                        yield return null;
                    }
                    
                    yield return GetCachedWaitForSeconds(currentDispenseInterval);
                }
                
                OnDispenseComplete?.Invoke(amount);
                
                // 繝｡繝｢繝ｪ繝ｪ繝ｼ繧ｯ蟇ｾ遲・ 螟ｧ驥乗賜蜃ｺ蠕隈C繧貞他縺ｳ蜃ｺ縺・
                if (amount > 50)
                {
                    System.GC.Collect();
                    yield return null;
                }
                
                // 謨ｴ蛻鈴幕蟋・
                yield return new WaitForSeconds(0.1f);
                StartCoroutine(SortCoinsCoroutine());
            }
            finally
            {
                isDispensing = false;
                Debug.Log("DispenseCoinsCoroutine completed, isDispensing set to false");
            }
        }
        
        private IEnumerator SortCoinsCoroutine()
        {
            if (isSorting) 
            {
                Debug.LogWarning("SortCoinsCoroutine already running, skipping...");
                yield break;
            }
            
            isSorting = true;
            Debug.Log("Starting SortCoinsCoroutine");
            
            try
            {
                // 繧ｳ繧､繝ｳ縺瑚誠縺｡逹縺上∪縺ｧ蠕・ｩ・
                yield return GetCachedWaitForSeconds(1f);
                
                // 謨ｴ蛻励い繝九Γ繝ｼ繧ｷ繝ｧ繝ｳ
                yield return StartCoroutine(AnimateCoinsToStacks());
                
                OnSortComplete?.Invoke(poolManager.ActiveCoins.Count);
                Debug.Log("SortCoinsCoroutine completed successfully");
                
                // 繝√こ繝・ヨ竊偵さ繧､繝ｳ螟画鋤繝√ぉ繝・け・医さ繧､繝ｳ縺悟ｰ代↑縺・ｴ蜷茨ｼ・
                if (enableTicketSystem)
                {
                    CheckAndConvertFromTickets();
                }
            }
            finally
            {
                isSorting = false;
                Debug.Log("SortCoinsCoroutine finished, isSorting set to false");
            }
        }
        
        private IEnumerator AnimateCoinsToStacks()
        {
            
            if (poolManager.ActiveCoins.Count == 0)
            {
                Debug.LogWarning("No active coins to animate");
                yield break;
            }

            // 譌｢蟄倥せ繧ｿ繝・け迥ｶ諷九ｒ繝・ヰ繝・げ蜃ｺ蜉・
            Debug.Log($"[10譫壻ｻ･荳汽EBUG] Existing stacks: {stackManager.CoinStacks.Count}");
            for (int i = 0; i < stackManager.CoinStacks.Count; i++)
            {
                Debug.Log($"[10譫壻ｻ･荳汽EBUG] Stack {i}: {GetStackContentsDebug(stackManager.CoinStacks[i])}");
            }

            // 繧ｳ繧､繝ｳ繧貞ｱｱ縺斐→縺ｫ繧ｰ繝ｫ繝ｼ繝怜喧・域里蟄倥・螻ｱ縺ｮ迥ｶ諷九ｒ閠・・・・
            List<List<GameObject>> stackGroups = new List<List<GameObject>>();
            int coinIndex = 0;
            int workingStackIndex = stackManager.CurrentStackIndex;
            
            // 蜷・ｱｱ縺ｫ繧ｳ繧､繝ｳ繧貞牡繧雁ｽ薙※・育樟蝨ｨ縺ｮ螻ｱ縺九ｉ邯咏ｶ夲ｼ・
            while (coinIndex < poolManager.ActiveCoins.Count)
            {
                List<GameObject> currentStackCoins = new List<GameObject>();
                
                // 迴ｾ蝨ｨ縺ｮ螻ｱ縺ｫ遨ｺ縺阪′縺ゅｋ蝣ｴ蜷医・縲√◎縺ｮ遨ｺ縺阪°繧牙沂繧√ｋ
                int availableSlots = coinsPerStack;
                if (workingStackIndex < stackManager.CoinStacks.Count)
                {
                    availableSlots = coinsPerStack - stackManager.CoinStacks[workingStackIndex].CoinCount;
                    Debug.Log($"[10譫壻ｻ･荳汽EBUG] Stack {workingStackIndex} has {availableSlots} available slots (CoinCount: {stackManager.CoinStacks[workingStackIndex].CoinCount})");
                }
                else
                {
                    Debug.Log($"[10譫壻ｻ･荳汽EBUG] Creating new stack {workingStackIndex} with {coinsPerStack} slots");
                }
                
                // 縺薙・螻ｱ縺ｫ蜑ｲ繧雁ｽ薙※蜿ｯ閭ｽ縺ｪ蛻・□縺代さ繧､繝ｳ繧定ｿｽ蜉
                for (int i = 0; i < availableSlots && coinIndex < poolManager.ActiveCoins.Count; i++)
                {
                    if (poolManager.ActiveCoins[coinIndex] != null)
                    {
                        currentStackCoins.Add(poolManager.ActiveCoins[coinIndex]);
                    }
                    coinIndex++;
                }
                
                if (currentStackCoins.Count > 0)
                {
                    stackGroups.Add(currentStackCoins);
                    // 繧ｰ繝ｫ繝ｼ繝嶺ｽ懈・螳御ｺ・
                }
                
                workingStackIndex++; // 谺｡縺ｮ螻ｱ縺ｸ
            }
            
            // 繧ｹ繧ｿ繝・け繧ｰ繝ｫ繝ｼ繝嶺ｽ懈・螳御ｺ・
            
            // 蜷・ｱｱ繧堤樟蝨ｨ菴咲ｽｮ縺九ｉ鬆・分縺ｫ遨阪∩荳翫￡
            for (int groupIndex = 0; groupIndex < stackGroups.Count; groupIndex++)
            {
                int actualStackIndex = stackManager.CurrentStackIndex + groupIndex;
                yield return StartCoroutine(AnimateStackSequentially(stackGroups[groupIndex], actualStackIndex));
                // 繧ｹ繧ｿ繝・け螳御ｺ・∵ｬ｡縺ｸ
                
                // 譛蠕後・螻ｱ縺ｧ縺ｪ縺代ｌ縺ｰ縲∵ｬ｡縺ｮ螻ｱ縺ｾ縺ｧ縺ｮ驕・ｻｶ繧貞・繧後ｋ
                if (groupIndex < stackGroups.Count - 1)
                {
                    yield return new WaitForSeconds(stackGroupDelay);
                    Debug.Log($"Waiting {stackGroupDelay}s before starting stack {actualStackIndex + 1}");
                }
            }
            
            // currentStackIndex繧呈峩譁ｰ・域ｬ｡蝗槭・縺溘ａ縺ｫ・・
            UpdateCurrentStackIndex();
            Debug.Log($"AnimateCoinsToStacks completed. Updated current stack index to: {stackManager.CurrentStackIndex}");
        }
        
        /// <summary>
        /// 迴ｾ蝨ｨ縺ｮ繧ｹ繧ｿ繝・け繧､繝ｳ繝・ャ繧ｯ繧ｹ繧呈峩譁ｰ・域ｺ譚ｯ縺ｧ縺ｪ縺・怙蛻昴・螻ｱ繧呈爾縺呻ｼ・
        /// </summary>
        private void UpdateCurrentStackIndex()
        {
            stackManager?.UpdateCurrentIndex();
        }
        
        /// <summary>
        /// 譫壽焚縺ｫ蠢懊§縺溘せ繧ｱ繝ｼ繝ｫ貂医∩騾溷ｺｦ繧貞叙蠕・
        /// </summary>
        /// <param name="coinAmount">繧ｳ繧､繝ｳ譫壽焚</param>
        /// <param name="minValue">譛鬮倬溷ｺｦ譎ゅ・蛟､・亥ｰ上＆縺・､・・/param>
        /// <param name="maxValue">譛菴朱溷ｺｦ譎ゅ・蛟､・亥､ｧ縺阪＞蛟､・・/param>
        /// <returns>繧ｹ繧ｱ繝ｼ繝ｫ貂医∩騾溷ｺｦ蛟､</returns>
        private float GetScaledSpeed(int coinAmount, float minValue, float maxValue)
        {
            if (!enableVariableSpeed)
            {
                return minValue < maxValue ? minValue : maxValue; // 蠕捺擂縺ｮ蝗ｺ螳壼､繧剃ｽｿ逕ｨ
            }
            
            // 譫壽焚豈皮紫繧定ｨ育ｮ暦ｼ・.0・・.0・・
            float ratio = Mathf.Clamp01((float)coinAmount / speedScaleThreshold);
            
            // 譫壽焚縺悟､壹＞縺ｻ縺ｩ鬮倬滂ｼ亥ｰ上＆縺・､・峨↓縺ｪ繧九ｈ縺・ｷ壼ｽ｢陬憺俣
            float scaledValue = Mathf.Lerp(maxValue, minValue, ratio);
            
            Debug.Log($"Scaled speed for {coinAmount} coins: {scaledValue} (ratio: {ratio:F2})");
            return scaledValue;
        }
        
        /// <summary>
        /// 遨阪∩荳翫￡蜑阪↓繧ｳ繧､繝ｳ謨ｰ繧偵メ繧ｧ繝・け縺励・0譫夊ｶ・℃譎ゅ↓繝√こ繝・ヨ蛹・- ConversionManager縺ｫ蟋碑ｭｲ
        /// </summary>
        private IEnumerator CheckCoinsBeforeSorting()
        {
            if (conversionManager == null) yield break;
            
            yield return conversionManager.CheckAndConvertToTickets(
                ConvertNewCoinsToTicket,
                CollectCoinsForTicket
            );
        }
        
        /// <summary>
        /// 譁ｰ隕乗賜蜃ｺ縺輔ｌ縺溘さ繧､繝ｳ繧偵メ繧ｱ繝・ヨ縺ｫ螟画鋤 - ConversionManager縺ｫ蟋碑ｭｲ
        /// </summary>
        private IEnumerator ConvertNewCoinsToTicket(int coinsToConvert)
        {
            if (conversionManager == null) yield break;
            
            yield return conversionManager.ConvertNewCoinsToTicket(
                coinsToConvert,
                dispenserPoint,
                AnimateCoinToDispenser,
                CreateTicketsCoroutine
            );
        }
        
        /// <summary>
        /// 螻ｱ縺九ｉ繧ｳ繧､繝ｳ繧貞屓蜿弱＠縺ｦ繝√こ繝・ヨ縺ｫ螟画鋤 - ConversionManager縺ｫ蟋碑ｭｲ
        /// </summary>
        private IEnumerator CollectCoinsForTicket(int coinsToCollect)
