# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# サウンドファイル除外
*.mp3
*.wav
*.ogg
*.aac
*.m4a

# アセットファイル除外（3Dモデル、テクスチャ等）
*.fbx
*.obj
*.blend
*.3ds
*.max
*.ma
*.mb
*.dae
*.png
*.jpg
*.jpeg
*.tga
*.bmp
*.psd
*.ai
*.exr
*.hdr
*.anim
*.controller
*.prefab
*.mat
*.asset
*.unity
*.spriteatlas
*.playable
*.signal
*.mask
*.overrideController
*.ttf
*.otf
*.physicMaterial

# フォルダ単位で除外
Assets/sound/
Assets/Materials/
Assets/Prefabs/
Assets/ボドゲ.fbm/

# すべての.metaファイルを除外
*.meta

# 含めるファイル（明示的指定）
!*.cs
!*.md
!*.json
!*.txt
!*.xml
!*.yml
!*.yaml
!*.shader

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ============================================================
#  テスト・計測の生成物 (2026-09-22 全面改訂)
#
#  **テストを回すたびに増えるものは全部ここで除外する。** 以前は生ログ (runs.jsonl /
#  detail.log) だけを除外し、 サマリーと学習集計は追跡していたが、 並列スイープ・
#  ワーカー用ビルドが後から増えたのに追随せず、 git status に未追跡が約 2 万件出ていた
#  (sweep 10,213 / rank_margin_parallel 3,747 / ワーカー用ビルド 約 5,000 …)。
#  **生成物を追跡する例外を作らないこと** ── 例外を 1 つ作ると、 次に増えた出力先が
#  またそこから漏れる。 ディスク側の古い出力は Tools/prune_outputs.py が自動で刈る。
# ============================================================

# 自動周回・スイープ・並列ランナーの出力すべて (学習データ・サマリー・生ログを含む)
/AutoRunLogs/

# ワーカー用の Standalone ビルド (実行ファイル + その実行結果)。 EnsureBuilt で再生成できる
/UltraProductionWorkerBuild/

# BOT が自動で追記するレポート (中身は改変しない規約は変わらない。 追跡だけやめた)
/BALANCE_CHANGELOG_*.md
/BALANCE_TIER_LIST_*.md

# スイープのアーム定義 (実験ごとの使い捨て) と Python のキャッシュ
/Tools/arms/
__pycache__/
