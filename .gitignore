# Unity プロジェクトの .gitignore
# 元: https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity が生成するもの
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 音
*.mp3
*.wav
*.ogg
*.aac
*.m4a

# 3D モデル・画像・Unity のアセット
*.fbx
*.obj
*.blend
*.3ds
*.max
*.ma
*.mb
*.dae
*.png
*.jpg
*.jpeg
*.tga
*.bmp
# 例外: GUI の元素材
!docs/design/gui/
!docs/design/gui/*.png
# 採用した絵 (遊ぶシーン Game2D から届くもの・品のアイコン・レアリティ枠) は git add -f で 1 枚ずつ追跡する。
# フォルダごと外すと試作の残骸まで入るので、 ここに例外は書かない
*.psd
*.ai
*.exr
*.hdr
*.anim
*.controller
*.prefab
*.mat
*.asset
*.unity
# 例外: 遊ぶシーン
!Assets/Scenes/Game2D.unity
*.spriteatlas
*.playable
*.signal
*.mask
*.overrideController
*.physicMaterial

# フォント
*.ttf
*.otf

# フォルダ単位
Assets/sound/
Assets/Materials/
Assets/Prefabs/
Assets/ボドゲ.fbm/

# .meta
*.meta

# 必ず含めるもの
!*.cs
!*.md
!*.json
!*.txt
!*.xml
!*.yml
!*.yaml
!*.shader

# 再配布できない第三者の素材
/Assets/Eric VFX Studio/
/Assets/Eric VFX Studio.meta

# IDE・ビルドの生成物
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# テスト・計測の生成物 (自動プレイ・スイープ・ワーカー用ビルド・自動生成レポート)
/AutoRunLogs/
/UltraProductionWorkerBuild/
/BALANCE_CHANGELOG_*.md
/BALANCE_TIER_LIST_*.md
/Tools/arms/
/Tools/pixelfx/records/
Tools/freemap_check/obj/
Tools/event_branch_check/obj/
Tools/rules_check/obj/
__pycache__/

# HTML / PDF (生成物・資料)
*.html
*.pdf

# CSV (測定・作業の書き出し。追跡しない)
*.csv
